#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
BASE="$ROOT/harness/opencode/opencode.jsonc"
PROFILE="$ROOT/harness/opencode/profiles/openai.jsonc"

command -v opencode >/dev/null 2>&1 || {
  printf 'openai: opencode is not installed\n' >&2
  exit 1
}

version=$(opencode --version)
[ "$version" = 1.18.22 ] || {
  printf 'openai: expected opencode 1.18.22, found %s\n' "$version" >&2
  exit 1
}

export OPENCODE_CONFIG="$BASE"
OPENCODE_CONFIG_CONTENT=$(<"$PROFILE")
export OPENCODE_CONFIG_CONTENT

exec opencode "$@"
