{
  "version": 1,
  "harness": "opencode",
  "links": [],
  "projectLinks": [],
  "imports": [],
  "jsonMerges": [],
  "agentRenders": [
    {
      "sourceDir": "agents",
      "catalog": "agents/manifest.json",
      "metadata": "harness/opencode/agents.json",
      "destination": "~/.config/opencode/agents",
      "format": "opencode",
      "target": "opencode"
    }
  ],
  "external": [
    {
      "path": "~/.config/opencode/plugins/herdr-agent-state.js",
      "owner": "herdr",
      "reason": "Vendor-managed plugin; its installer owns updates."
    }
  ],
  "deferred": [
    {
      "path": "~/.config/opencode/commands",
      "reason": "Native command binders land after portable personas."
    },
    {
      "path": "~/.config/opencode/plugins/main-branch-guard.ts",
      "reason": "Native hook adapters land after persona rendering."
    }
  ]
}
